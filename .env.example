# Operational data: keep existing credentials; FastAPI enforces read-only operations.
LEAD_MONGO_URI=
DELIVERY_CENTER_MONGO_URI=

# Application writes must target this database; no credential changes are required now.
AI_LAYER_MONGO_URI=
AI_LAYER_DB_NAME=byd_ai_layer

# Required before serving cursor-based lists. Generate a unique Fernet key; do not reuse another key.
AI_LAYER_CURSOR_ENCRYPTION_KEY=

# Supply the provider key in the local .env only. Select the model during setup.
OPENAI_TRACING_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# NextAuth Google provider. Keep secrets server-only; configure the local URL/callback during setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=

# App-level tracing settings; must be mapped explicitly to Agents SDK controls.
# Missing enablement means off. Outside development, export is off without separate approval.
# Real operational data and Temporary Chat require sensitive capture off.
# The app factory keeps native export off. Trusted server startup must explicitly
# attach the sanitized exporter after provider access/retention review.
# Only explicit true enables tracing. Invalid values mean off; sensitive capture
# remains false even if its setting is changed to true.
APP_ENV=development
OPENAI_TRACING_ENABLED=true
OPENAI_TRACING_INCLUDE_SENSITIVE_DATA=false
